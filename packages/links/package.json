{
  "name": "@botharness/links-worker",
  "version": "0.0.0",
  "private": true,
  "description": "Campaign short link Worker: go.botharness.ai redirects with UTM parameters and counts clicks (ADR-0132)",
  "type": "module",
  "scripts": {
    "build:assets": "node scripts/build-admin-assets.mjs",
    "dev": "pnpm build:assets && wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply LINKS_DB --local",
    "deploy": "pnpm build:assets && wrangler deploy"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.6.3",
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@tanstack/charts": "1.0.0",
    "hono": "^4.13.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "wrangler": "^4.95.0"
  }
}
