{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  // Ordered on purpose: the client's session-store declaration must be
  // processed before host packages that import `@deepseek-ai/dsh-agent`.
  // Both augment `ctx.sessions` with different `list` types; the first
  // declaration in program order wins, and an alphabetical `packages/*/src`
  // put `packages/browser` first, which made `ctx.sessions.list` lose its
  // store methods in `packages/client`.
  "include": [
    "packages/client/src",
    "packages/computer/src",
    "packages/core/src",
    "packages/deepseekbot/src",
    "packages/browser/src",
    "packages/market/src",
    "packages/*/test",
    "*.config.ts"
  ]
}
