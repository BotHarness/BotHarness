{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "tabWidth": 2,
  "ignorePatterns": [
    "dist",
    "coverage",
    "pnpm-lock.yaml",
    ".agents",
    ".claude",
    "agent",
    "apps/docs",
    ".scratch"
  ]
}
