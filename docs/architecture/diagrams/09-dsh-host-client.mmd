flowchart TB
  subgraph Host["DSH Host"]
    direction LR
    HostPlugin["Host Cordis Plugin"] --> Service["Host Service"]
    Service --> Remote["TypertRemoteService"]
    ReadRPC["botharness/channelMarkAllRead<br/>应用定义的 RPC"] --> Channels["Channel owner<br/>可见消息位置快照"]
    Channels --> ReadPositions["既有 Human 已读位置"]
    Remote <--> Gateway["API Gateway<br/>唯一 /api interceptor"]
    Registry["Registry / Activity / Session ownership"] --> Feed["应用定义的 Companion Feed"]
    Channels --> Feed
  end
  subgraph Browser["DSH Web Client"]
    direction LR
    ClientPlugin["Browser Cordis Plugin"] --> Model["Client model"]
    Overview["BotHarness Overview"] --> ReadAction["actions.markAllRead"]
    Model --> Slots["Slots<br/>UI composition"]
    Companion["WindowCompanion owner<br/>Client Plugin 生命周期"] --> Overlay["shell.overlay"]
    Companion --> Activity["共享 Client Activity store<br/>钉选时替代独立 Activity SSE"]
  end
  Gateway <--> Model
  Gateway -->|"受认证的 Connection Fetch"| Feed
  Feed -->|"/api/botharness/companion SSE<br/>基线 + 未来消息"| Companion
  ReadAction --> Gateway
  Remote --> ReadRPC
  Overview --> UsageAction["actions.overviewUsage"]
  UsageAction --> Gateway
  Remote --> UsageRPC["overviewUsage<br/>application-defined RPC"]
  UsageRPC --> UsageOwner["Retained Usage owner<br/>global totals / daily buckets / Bot pages"]
