---
import Icon from "@cloudflare/nimbus-docs/components/Icon.astro";
import { Button } from "./ui/button";
import { LinkButton } from "./ui/link-button";
import { ThemeToggle } from "./ui/theme-toggle";
import SearchTrigger from "./ui/search/SearchTrigger.astro";
import { config } from "virtual:nimbus/config";
import { stripBase, withBase } from "@cloudflare/nimbus-docs/runtime";
import { languageLinks, localeFromPath, siteChrome } from "@/lib/language";

interface Props {
  /** Astro collection id for the current page, forwarded from DocsLayout. */
  collection?: string;
  /** Astro entry id for the current page, forwarded from DocsLayout. */
  entryId?: string;
  /**
   * Whether the page has a sidebar to open. When `false`, the mobile
   * menu button is hidden — pages that opted out via `sidebar: false`
   * shouldn't show a button that opens an empty dialog. Default `true`.
   */
  showSidebar?: boolean;
}

const { showSidebar = true } = Astro.props;

// Normalize trailing slash so isActive matches sidebar hrefs.
const currentSlug = stripBase(Astro.url.pathname, import.meta.env.BASE_URL).replace(/\/$/, "") || "/";

// Manual language switcher (plain links, no JS). `links.en` is the current
// route with any `/zh` prefix stripped, so section highlighting stays correct
// on Chinese pages too. Chinese pages keep Chinese labels for the site nav;
// English pages get English labels.
const links = languageLinks(currentSlug);
const chrome = siteChrome(localeFromPath(currentSlug));
const homeHref = withBase(links.isZh ? "/zh" : "/", import.meta.env.BASE_URL);
const localePrefix = links.isZh ? "/zh" : "";

const SITE_LINKS = [
  {
    href: "/docs/overview",
    label: chrome.docs,
    icon: "hugeicons:book-02",
    prefix: "/docs",
  },
  {
    href: "/dsh",
    label: chrome.dsh,
    icon: "ph:puzzle-piece",
    prefix: "/dsh",
  },
  {
    href: "/dev/architecture",
    label: chrome.dev,
    icon: "hugeicons:code",
    prefix: "/dev",
  },
  { href: "/changelog", label: chrome.changelog, icon: "hugeicons:megaphone-01", prefix: "/changelog" },
];

const isActive = (prefix: string): boolean =>
  links.en === prefix || links.en.startsWith(`${prefix}/`);

const langLinkClass = (active: boolean): string =>
  `rounded-[0.25rem] px-1.5 py-0.5 text-[0.6875rem] font-semibold leading-4 no-underline transition-colors ${
    active ? "bg-accent text-foreground" : "text-muted-foreground hover:text-foreground"
  }`;
---

<header class="sticky top-0 z-30 border-b border-border bg-card/80 backdrop-blur-lg">
  <div class="mx-auto flex items-center justify-between gap-3 h-14 px-4 lg:px-6">
    <div class="flex items-center gap-3 min-w-0">
      <slot name="brand">
        <a href={homeHref} class="group shrink-0">
          <span class="font-semibold text-sm text-foreground group-hover:text-primary transition-colors">
            {config.title}
          </span>
        </a>
      </slot>

      <nav
        aria-label={chrome.sections}
        class="hidden md:flex items-center gap-1 ml-4 pl-4 border-l border-border h-6 min-w-0 overflow-x-auto [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
      >
        {SITE_LINKS.map((link) => (
          <a
            href={withBase(`${localePrefix}${link.href}`, import.meta.env.BASE_URL)}
            aria-current={isActive(link.prefix) ? "page" : undefined}
            class:list={[
              "inline-flex items-center gap-1.5 px-2 py-1 rounded-md text-[0.8125rem] font-medium no-underline transition-colors shrink-0 whitespace-nowrap",
              isActive(link.prefix)
                ? "text-foreground bg-accent"
                : "text-muted-foreground hover:text-foreground hover:bg-accent/60",
            ]}
          >
            <Icon name={link.icon} class="w-3.5 h-3.5" />
            <span class="hidden lg:inline">{link.label}</span>
          </a>
        ))}
      </nav>
    </div>

    <div class="flex items-center gap-2 shrink-0">
      <slot name="actions" />
      <nav
        aria-label={chrome.language}
        class="flex items-center rounded-md border border-border p-0.5"
      >
        <a
          href={withBase(links.en, import.meta.env.BASE_URL)}
          aria-current={links.isZh ? undefined : "page"}
          class={langLinkClass(!links.isZh)}
        >
          EN
        </a>
        <a
          href={withBase(links.zh, import.meta.env.BASE_URL)}
          aria-current={links.isZh ? "page" : undefined}
          class={langLinkClass(links.isZh)}
        >
          中文
        </a>
      </nav>
      {config.github && (
        <LinkButton
          href={config.github}
          variant="minimal"
          shape="square"
          size="sm"
          aria-label="GitHub"
          target="_blank"
          rel="noopener"
          class="text-muted-foreground"
        >
          <Icon name="ph:github-logo" class="w-4 h-4" />
        </LinkButton>
      )}
      {config.search !== false && <SearchTrigger />}
      <ThemeToggle aria-label={chrome.toggleTheme} />
      {showSidebar && (
        <Button
          variant="ghost"
          shape="square"
          size="sm"
          icon="ph:list"
          aria-label={chrome.openNavigation}
          data-menu-btn
          class="md:hidden text-muted-foreground"
        />
      )}
    </div>
  </div>
</header>
