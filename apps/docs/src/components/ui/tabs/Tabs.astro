---
import { cn } from "@/lib/cn";
import type { HTMLAttributes } from "astro/types";
import TabsList from "./TabsList.astro";

interface Props extends HTMLAttributes<"div"> {
  syncKey?: string;
}

const { syncKey, class: className, ...attrs } = Astro.props;
---

<div
  data-nb-tabs
  data-nb-sync-key={syncKey}
  class={cn(className)}
  {...attrs}
>
  <TabsList />
  <div class="mt-3">
    <slot />
  </div>
</div>

<script>
  import "./tabs.client";
</script>
