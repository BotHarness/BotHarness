---
import "@fontsource-variable/inter";
import "@fontsource-variable/jetbrains-mono";
import "../styles/globals.css";
import "../styles/prose.css";
import "../styles/mermaid.css";
import { ClientRouter } from "astro:transitions";
import { config } from "virtual:nimbus/config";
import {
  getCollectionLlmsUrl,
  getVersionStatus,
  stripBase,
  withBase,
} from "@cloudflare/nimbus-docs/runtime";
import AgentDirective from "@/components/AgentDirective.astro";
import { SearchDialog } from "@/components/ui/search";
import { localeAlternates, siteChrome } from "@/lib/language";
import NimbusHead from "@cloudflare/nimbus-docs/components/NimbusHead.astro";
import type { BasePageProps, HeadElement } from "@cloudflare/nimbus-docs/types";

type Props = BasePageProps & {
  /**
   * Set on language-variant pages (e.g. `/zh/**`). The collection is a
   * translation of the primary docs, not an older snapshot, so Nimbus must not
   * canonicalize it to the English sibling or emit cross-version alternates.
   */
  suppressVersionAlternates?: boolean;
};

const {
  title,
  description,
  noindex,
  markdownUrl,
  socialImage,
  lastUpdated,
  head: pageHead = [],
  collection,
  entryId,
  apiVersion,
  coordinate,
  suppressVersionAlternates = false,
} = Astro.props;
// Route-aware language. Nimbus has no i18n, so the site derives `<html lang>`
// (and Pagefind's per-language index) from the URL: `/zh/**` is Simplified
// Chinese, everything else is English.
const pathname = stripBase(Astro.url.pathname, import.meta.env.BASE_URL);
const lang = pathname === "/zh" || pathname.startsWith("/zh/") ? "zh-Hans" : "en";
const chrome = siteChrome(lang);
// Per-page agent-index pointer. For pages in non-primary or version
// collections, this resolves to `/<prefix>/llms.txt` (e.g. `/v0/llms.txt`
// for a v0 docs page, `/blog/llms.txt` for a blog post). Falls back to
// the root `/llms.txt` when no collection is provided.
// Hidden-version pages don't advertise an agent index (the per-version
// llms.txt isn't emitted for them); suppress the AgentDirective entirely.
const versionStatusKey =
  apiVersion && collection ? `${collection}@${apiVersion}` : collection;
const versionStatus = versionStatusKey
  ? await getVersionStatus(versionStatusKey)
  : null;
const isHiddenVersion = versionStatus?.isHidden === true;
const llmsIndexPath = collection
  ? await getCollectionLlmsUrl(collection)
  : "/llms.txt";
const baseUrl = import.meta.env.BASE_URL;
const basedLlmsUrl = withBase(llmsIndexPath, baseUrl);
const llmsUrl = Astro.site
  ? new URL(basedLlmsUrl, Astro.site).href
  : basedLlmsUrl;
const basedMarkdownUrl = markdownUrl ? withBase(markdownUrl, baseUrl) : undefined;
const resolvedMarkdownUrl =
  basedMarkdownUrl && Astro.site
    ? new URL(basedMarkdownUrl, Astro.site).href
    : basedMarkdownUrl;

// hreflang: Nimbus has no i18n, so the tree derives alternates from the
// route: the counterpart tree in both directions plus an English
// `x-default` (the root tree is primary). noindex pages (404s, drafts) are
// skipped — search engines ignore hreflang there.
//
// Known limitation: NimbusHead hardcodes `og:locale` (and JSON-LD
// `inLanguage`) to `config.locale` ("en"), so `/zh/**` pages advertise the
// primary locale there. A per-page override would duplicate the tag in
// `<head>`, which is worse than the stale value; leave it until the
// framework parameterizes it.
const languageHead: HeadElement[] = noindex
  ? []
  : localeAlternates(pathname).map(({ hreflang, path }) => ({
      tag: "link",
      attrs: {
        rel: "alternate",
        hreflang,
        href: Astro.site
          ? new URL(withBase(path, baseUrl), Astro.site).href
          : withBase(path, baseUrl),
      },
    }));
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <script is:inline>
      (() => {
        const KEY = "ui-mode";
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const readPref = () => {
          try {
            const v = localStorage.getItem(KEY);
            return v === "dark" || v === "light" ? v : null;
          } catch {
            return null;
          }
        };

        const resolveMode = () => readPref() ?? (media.matches ? "dark" : "light");

        const applyTheme = () => {
          const root = document.documentElement;
          const mode = resolveMode();
          if (mode === "dark") root.setAttribute("data-mode", "dark");
          else root.removeAttribute("data-mode");
          root.style.colorScheme = mode;
          document.querySelectorAll("[data-nb-theme-toggle]").forEach((b) => {
            b.setAttribute("data-nb-state", mode);
          });
        };

        applyTheme();
        document.addEventListener("astro:after-swap", applyTheme);
        media.addEventListener("change", () => {
          if (!readPref()) applyTheme();
        });
        window.addEventListener("storage", (e) => {
          if (e.key === KEY) applyTheme();
        });

        window.__nbApplyTheme = applyTheme;
      })();
    </script>

    <NimbusHead
      title={title}
      description={description}
      noindex={noindex}
      markdownUrl={markdownUrl}
      socialImage={socialImage}
      lastUpdated={lastUpdated}
      head={[...pageHead, ...languageHead]}
      collection={collection}
      entryId={suppressVersionAlternates ? undefined : entryId}
      apiVersion={apiVersion}
      coordinate={coordinate}
    />
    <ClientRouter />
  </head>
  <body class="min-h-screen bg-background text-foreground antialiased">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-100 focus:rounded-md focus:bg-primary focus:px-4 focus:py-2 focus:text-sm focus:font-medium focus:text-primary-foreground focus:no-underline focus-visible:outline-2 focus-visible:outline-ring focus-visible:outline-offset-2"
    >
      {chrome.skipToContent}
    </a>
    {resolvedMarkdownUrl && !isHiddenVersion && (
      <AgentDirective markdownUrl={resolvedMarkdownUrl} llmsUrl={llmsUrl} />
    )}
    <slot />
    {config.search !== false && <SearchDialog />}

    <script>
      import { codeCopy, headingAnchors } from "@cloudflare/nimbus-docs/client";
      codeCopy();
      headingAnchors();
    </script>

    <script>
      import "../scripts/mermaid";
    </script>
  </body>
</html>
