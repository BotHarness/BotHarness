---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Landing from "../../components/landing/Landing";
import { getCollection } from "astro:content";
import "../../../../../design/tokens.css";

export const prerender = true;

const recent = (await getCollection("changelog-zh", (entry) => !entry.data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3)
  .map((entry) => ({
    title: entry.data.title,
    href: `/zh/changelog/${entry.id}`,
    date: entry.data.date.toISOString().slice(0, 10),
  }));
---

<BaseLayout
  title="BotHarness — 给 LLM agent 一份持久身份"
  description="给 LLM agent 一份持久身份的 DSH 插件层：PersonaBot —— 带人格、跨 session 记忆、可并发工作。"
>
  <Header showSidebar={false} />
  <div class="relative isolate" data-bh-landing>
    <Landing recent={recent} lang="zh" />
  </div>
</BaseLayout>
