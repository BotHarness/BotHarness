---
import BaseLayout from "../layouts/BaseLayout.astro";
import Landing from "../components/landing/Landing";
import { config } from "virtual:nimbus/config";
import "../../../../design/tokens.css";

// Prerender explicitly so the homepage stays a static route under
// `output: "server"` — an adapter alone must add zero on-demand routes.
export const prerender = true;
---

<BaseLayout title={config.title} description={config.description}>
  <!-- `isolate` scopes Base UI layering (coss requirement); `relative` keeps
       portaled backdrops anchored on the landing scope instead of `body`. -->
  <div class="relative isolate" data-bh-landing>
    <Landing />
  </div>
</BaseLayout>
