---
// Bare `/en` path → the English docs landing. Static output has no server
// redirects, so this is a meta-refresh page with a canonical + link fallback.
import { config } from "virtual:nimbus/config";

export const prerender = true;

const target = "/en/docs/overview";
const canonical = new URL(target, config.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Redirecting…</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={canonical} />
  </head>
  <body>
    <a href={target}>Redirecting to {target}</a>
  </body>
</html>
